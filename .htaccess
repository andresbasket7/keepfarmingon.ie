# ================================
# Browser caching - KeepFarmingOn.ie
# ================================

<IfModule mod_expires.c>
  ExpiresActive On

  # Imágenes - cache 1 año
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/jpg  "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # CSS y JS - cache 1 mes
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Cache-Control headers para imágenes
  <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # Cache-Control headers para CSS y JS
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>

# ================================
# Archivos específicos detectados
# ================================
<IfModule mod_headers.c>
  # Imágenes grandes
  <FilesMatch "person\.webp|family\.webp|LOT_2\.jpg|sheeps2\.webp|Corn\.webp|COWS\.webp|suckler\.webp|cow\.webp|Nick-Davis-c-Debbie-James\.jpg|Discussing\.webp|isolation\.jpg|Reunion\.webp|icons\.webp|soundadvice\.webp|Meeting\.webp|person_hole\.webp|Support_services\.webp|LOGO\.png|group\.webp|marco_signal\.webp">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # CSS
  <FilesMatch "style\.css|responsive\.css">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # JS
  <FilesMatch "hero\.js|change\.js">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
</IfModule>